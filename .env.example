# Ссылка GET на API организаторов (кнопка «Открыть GET для DEV» в задании).
# Параметр group_id подставляется автоматически, его можно оставить или убрать.
DATA_API_URL=

# Оценщик: ollama (гибрид: правила + локальная модель) | claude | openai | heuristic
CQA_EVALUATOR=ollama
CQA_MODEL=qwen2.5:3b
CQA_CONCURRENCY=1

# Для режима claude:
ANTHROPIC_API_KEY=

# Необязательно:
# CQA_EFFORT=medium           # low | medium | high
# CQA_FALLBACKS=1             # серверный фолбэк Claude при отказе модели
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
