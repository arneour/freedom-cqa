# Ссылка GET на API организаторов (кнопка «Открыть GET для DEV» в задании).
# Параметр group_id подставляется автоматически, его можно оставить или убрать.
DATA_API_URL=

# Ключ Claude API. Без него работает демо-оценщик на ключевых словах.
ANTHROPIC_API_KEY=

# Необязательно:
# CQA_EVALUATOR=claude        # claude | ollama | heuristic
# CQA_MODEL=claude-opus-5-5   # для ollama, например qwen2.5:3b
# CQA_EFFORT=medium           # low | medium | high
# CQA_CONCURRENCY=4           # параллельных оценок при пакетном запуске
# CQA_FALLBACKS=1             # серверный фолбэк Claude при отказе модели
# OLLAMA_URL=http://localhost:11434
